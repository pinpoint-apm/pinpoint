###########################################################
# user defined classes                                    #
###########################################################
profiler.entrypoint=test.pinpoint.plugin.reactor.ReactorFlow.execute,test.pinpoint.plugin.reactor.Echo.get

###########################################################
# stage 2 exact retry subscriber carrier                  #
###########################################################
# The generic operator-subscriber layer is deliberately disabled. These tests therefore pass only
# when FluxRetry$RetrySubscriber and RetryWhenMainSubscriber own their seed and restore it around
# the actual resubscribe call.
profiler.reactor.subscriber.instrument=false
profiler.reactor.trace.retry=true
