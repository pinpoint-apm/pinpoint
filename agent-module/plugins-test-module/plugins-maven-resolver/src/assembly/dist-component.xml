<?xml version="1.0" encoding="UTF-8"?>
<!--
  pinpoint-plugins-maven-resolver.jar   the resolver, a fixed name so a version bump never leaves two jars at the root
  lib/*.jar                             its runtime dependencies, untouched
-->
<component xmlns="http://maven.apache.org/ASSEMBLY-COMPONENT/2.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://maven.apache.org/ASSEMBLY-COMPONENT/2.0.0 http://maven.apache.org/xsd/assembly-component-2.0.0.xsd">
    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>/</outputDirectory>
            <destName>pinpoint-plugins-maven-resolver.jar</destName>
        </file>
    </files>
    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <scope>runtime</scope>
            <useProjectArtifact>false</useProjectArtifact>
            <!-- provided: comes from the parent loader (plugins-test), a copy in lib/ breaks the TaggedLogger type shared through TestLogger -->
            <excludes>
                <exclude>org.tinylog:tinylog-api</exclude>
            </excludes>
        </dependencySet>
    </dependencySets>
</component>
