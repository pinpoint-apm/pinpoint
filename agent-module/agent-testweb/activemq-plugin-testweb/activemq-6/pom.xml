<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.navercorp.pinpoint</groupId>
        <artifactId>pinpoint-activemq-plugin-testweb</artifactId>
        <version>4.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pinpoint-activemq-6</artifactId>
    <packaging>jar</packaging>

    <properties>
        <!-- newer than the ActiveMQ managed by the Spring Boot 4 BOM -->
        <activemq6.version>6.4.0</activemq6.version>
        <pinpoint.agent.jvmargument>
            ${pinpoint.agent.default.jvmargument}
        </pinpoint.agent.jvmargument>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- imported before the Spring Boot BOM so that it takes precedence -->
            <dependency>
                <groupId>org.apache.activemq</groupId>
                <artifactId>activemq-bom</artifactId>
                <version>${activemq6.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.navercorp.pinpoint</groupId>
            <artifactId>pinpoint-agent-testweb-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- the root pom drops logback from spring-boot-starter-logging; bring it back so the app logs -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <!-- ActiveMQ 6.x (jakarta.jms) with Spring JMS; the client endpoints use the same activemq-client -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-activemq</artifactId>
        </dependency>
        <!-- the app starts its own broker, so no external ActiveMQ is needed -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-broker</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
