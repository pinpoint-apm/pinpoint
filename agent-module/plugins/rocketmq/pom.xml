<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.navercorp.pinpoint</groupId>
    <artifactId>pinpoint-plugins</artifactId>
    <version>4.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pinpoint-rocketmq-plugin</artifactId>
  <name>pinpoint-rocketmq-plugin</name>
  <packaging>jar</packaging>

  <properties>
    <jdk.version>1.8</jdk.version>
    <jdk.home>${env.JAVA_8_HOME}</jdk.home>
    <!-- Compile against Netty 4.1; see netty41.version in the root pom. -->
    <netty4.version>${netty41.version}</netty4.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.navercorp.pinpoint</groupId>
      <artifactId>pinpoint-bootstrap-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-client</artifactId>
      <version>${plugins-bom.rocketmq.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Declared directly so that the classes stay on the compile classpath whichever
         Netty line this module compiles against: netty-bom 4.2 manages these jars in a way
         that demotes them to runtime when they only come in transitively. -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-common</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-buffer</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

</project>