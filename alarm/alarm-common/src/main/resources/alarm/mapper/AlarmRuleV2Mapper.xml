<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.navercorp.pinpoint.alarm.dao.mapper.AlarmRuleV2Mapper">
    <resultMap id="ruleDetailsResultMap"
               type="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleDetailsEntity">
        <association property="rule"
                     javaType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity">
            <id property="id" column="rule_id" />
            <result property="dataSource" column="rule_data_source" />
            <result property="templateItemId" column="rule_template_item_id" />
            <result property="applicationType" column="rule_application_type" />
            <result property="serviceName" column="rule_service_name" />
            <result property="applicationName" column="rule_application_name" />
            <result property="enabled" column="rule_enabled" />
            <result property="updatedAt" column="rule_updated_at" />
        </association>
        <association property="localConfig"
                     javaType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleLocalConfigEntity"
                     notNullColumn="local_rule_id">
            <id property="ruleId" column="local_rule_id" />
            <result property="name" column="local_name" />
            <result property="description" column="local_description" />
            <result property="severity" column="local_severity" />
            <result property="checkIntervalSec" column="local_check_interval_sec" />
            <result property="actionIntervalSec" column="local_action_interval_sec" />
            <result property="conditions" column="local_conditions" />
            <result property="filters" column="local_filters" />
        </association>
        <association property="templateItem"
                     javaType="com.navercorp.pinpoint.alarm.dao.entity.AlarmTemplateItemEntity"
                     notNullColumn="item_id">
            <id property="id" column="item_id" />
            <result property="templateId" column="item_template_id" />
            <result property="name" column="item_name" />
            <result property="description" column="item_description" />
            <result property="severity" column="item_severity" />
            <result property="dataSource" column="item_data_source" />
            <result property="checkIntervalSec" column="item_check_interval_sec" />
            <result property="actionIntervalSec" column="item_action_interval_sec" />
            <result property="conditions" column="item_conditions" />
            <result property="filters" column="item_filters" />
            <result property="updatedAt" column="item_updated_at" />
        </association>
        <association property="template"
                     javaType="com.navercorp.pinpoint.alarm.vo.AlarmTemplate"
                     notNullColumn="template_id">
            <id property="id" column="template_id" />
            <result property="serviceName" column="template_service_name" />
            <result property="name" column="template_name" />
            <result property="description" column="template_description" />
            <result property="updatedAt" column="template_updated_at" />
        </association>
    </resultMap>

    <sql id="applicationPredicate">
        r.service_name = #{serviceName}
          AND r.application_name = #{applicationName}
          AND r.application_type = #{applicationType}
    </sql>

    <sql id="ruleMetadataColumns">
        r.id,
        r.data_source,
        r.template_item_id,
        r.service_name,
        r.application_name,
        r.application_type,
        r.enabled,
        r.updated_at
    </sql>

    <!-- The rule carries its own application now, so no join is needed to name it. -->
    <!-- Soft-deleting the item or its bundle header hides the rule from
         evaluation and the API until the cleanup batch removes it physically.
         A dangling template_item_id (no item row) intentionally stays active so
         resolution fails loudly (CHECK_FAILED) instead of vanishing silently. -->
    <sql id="activeTemplatePredicate">
        (
            r.template_item_id IS NULL
            OR NOT EXISTS (
                SELECT 1
                FROM alarm_template_item deleted_item
                LEFT JOIN alarm_template deleted_header
                       ON deleted_header.id = deleted_item.template_id
                WHERE deleted_item.id = r.template_item_id
                  AND (deleted_item.deleted = 1 OR deleted_header.deleted = 1)
            )
        )
    </sql>

    <insert id="insertRule"
            parameterType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO alarm_rule_v2 (
            data_source, template_item_id, service_name, application_name, application_type, enabled
        )
        VALUES (
            #{dataSource}, #{templateItemId}, #{serviceName}, #{applicationName}, #{applicationType}, #{enabled}
        )
    </insert>

    <update id="updateRule"
            parameterType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity">
        UPDATE alarm_rule_v2
        SET data_source = #{dataSource},
            template_item_id = #{templateItemId},
            service_name = #{serviceName},
            application_name = #{applicationName},
            application_type = #{applicationType},
            enabled = #{enabled},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <update id="updateEnabled">
        UPDATE alarm_rule_v2 SET enabled = #{enabled} WHERE id = #{id}
    </update>

    <delete id="deleteRule" parameterType="Long">
        DELETE FROM alarm_rule_v2 WHERE id = #{id}
    </delete>

    <!-- The three application columns are not indexed, so this lookup is a full scan.
         Collecting the ids first, unlocked, lets every delete that follows go by primary
         key, which keeps the delete transaction from taking next-key locks table-wide. -->
    <select id="selectRuleIdsByApplication" resultType="Long">
        SELECT r.id
        FROM alarm_rule_v2 r
        WHERE <include refid="applicationPredicate" />
    </select>

    <delete id="deleteByIds">
        DELETE FROM alarm_rule_v2
        WHERE id IN
        <foreach item="ruleId" collection="ruleIds" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>

    <select id="selectRuleById" parameterType="Long"
            resultType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity">
        SELECT <include refid="ruleMetadataColumns" />
        FROM alarm_rule_v2 r
        WHERE r.id = #{id}
          AND <include refid="activeTemplatePredicate" />
    </select>

    <select id="selectRuleDetailsById" parameterType="Long" resultMap="ruleDetailsResultMap">
        SELECT r.id AS rule_id,
               r.data_source AS rule_data_source,
               r.template_item_id AS rule_template_item_id,
               r.service_name AS rule_service_name,
               r.application_name AS rule_application_name,
               r.application_type AS rule_application_type,
               r.enabled AS rule_enabled,
               r.updated_at AS rule_updated_at,
               lc.rule_id AS local_rule_id,
               lc.name AS local_name,
               lc.description AS local_description,
               lc.severity AS local_severity,
               lc.check_interval_sec AS local_check_interval_sec,
               lc.action_interval_sec AS local_action_interval_sec,
               lc.conditions AS local_conditions,
               lc.filters AS local_filters,
               i.id AS item_id,
               i.template_id AS item_template_id,
               i.name AS item_name,
               i.description AS item_description,
               i.severity AS item_severity,
               i.data_source AS item_data_source,
               i.check_interval_sec AS item_check_interval_sec,
               i.action_interval_sec AS item_action_interval_sec,
               i.conditions AS item_conditions,
               i.filters AS item_filters,
               i.updated_at AS item_updated_at,
               t.id AS template_id,
               t.service_name AS template_service_name,
               t.name AS template_name,
               t.description AS template_description,
               t.updated_at AS template_updated_at
        FROM alarm_rule_v2 r
        LEFT JOIN alarm_rule_local_config lc ON lc.rule_id = r.id
        LEFT JOIN alarm_template_item i ON i.id = r.template_item_id
                                                AND i.deleted = 0
        LEFT JOIN alarm_template t ON t.id = i.template_id
                                           AND t.deleted = 0
        WHERE r.id = #{id}
          AND <include refid="activeTemplatePredicate" />
    </select>

    <select id="selectRuleByIdForUpdate" parameterType="Long"
            resultType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity">
        SELECT <include refid="ruleMetadataColumns" />
        FROM alarm_rule_v2 r
        WHERE r.id = #{id}
          AND <include refid="activeTemplatePredicate" />
        FOR UPDATE
    </select>

    <!-- Live items only. Rules of a soft-deleted item are already invisible
         everywhere else and belong to the cleanup batch, so counting them here
         would both block re-applying the bundle and race the batch over the
         same rows. -->
    <select id="selectAppliedApplicationsForUpdate" parameterType="Long"
            resultType="com.navercorp.pinpoint.alarm.vo.AlarmApplication">
        SELECT DISTINCT r.service_name, r.application_name, r.application_type
        FROM alarm_rule_v2 r
        JOIN alarm_template_item i ON i.id = r.template_item_id
        WHERE i.template_id = #{templateId}
          AND i.deleted = 0
        ORDER BY r.service_name, r.application_name, r.application_type
        FOR UPDATE
    </select>

    <select id="selectRulesByTemplateIdAndApplicationForUpdate"
            resultType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity">
        SELECT <include refid="ruleMetadataColumns" />
        FROM alarm_rule_v2 r
        WHERE <include refid="applicationPredicate" />
          AND r.template_item_id IN (
              SELECT i.id
              FROM alarm_template_item i
              WHERE i.template_id = #{templateId}
                AND i.deleted = 0
          )
        ORDER BY r.id
        FOR UPDATE
    </select>

    <select id="selectEnabledRules"
            resultType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity">
        SELECT <include refid="ruleMetadataColumns" />
        FROM alarm_rule_v2 r
        WHERE r.enabled = 1
          AND <include refid="activeTemplatePredicate" />
    </select>

    <select id="selectEnabledRulesAfter"
            resultType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity">
        SELECT <include refid="ruleMetadataColumns" />
        FROM alarm_rule_v2 r
        WHERE r.enabled = 1
          AND r.id &gt; #{afterId}
          AND <include refid="activeTemplatePredicate" />
        ORDER BY r.id
        LIMIT #{limit}
    </select>

    <select id="selectDueEnabledRulesAfter"
            resultType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity">
        SELECT <include refid="ruleMetadataColumns" />
        FROM alarm_rule_v2 r
        LEFT JOIN alarm_state s ON r.id = s.rule_id
        WHERE r.enabled = 1
          AND r.id &gt; #{afterId}
          AND <include refid="activeTemplatePredicate" />
          AND (
            s.next_check_at IS NULL
            OR s.next_check_at &lt;= #{now}
          )
        <!-- Order by r.id: ordering by an expression leaves no index able to supply the
             order (Using temporary; Using filesort), so every matching row is evaluated and
             sorted before LIMIT applies. Measured on 5.6 with 42,000 rows and 10% due, that
             is 456ms against 34ms. The caller is a drain loop that repeats until the due set
             is empty, so the order within a sweep does not change the outcome. -->
        ORDER BY r.id ASC
        LIMIT #{limit}
    </select>

    <select id="selectRulesByApplication"
            resultType="com.navercorp.pinpoint.alarm.dao.entity.AlarmRuleEntity">
        SELECT <include refid="ruleMetadataColumns" />
        FROM alarm_rule_v2 r
        WHERE <include refid="applicationPredicate" />
          AND <include refid="activeTemplatePredicate" />
    </select>

</mapper>
